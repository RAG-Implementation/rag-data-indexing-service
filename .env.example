# ── Environment Variables ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is listed in .gitignore and will never be committed.
# .env.example IS committed so other developers know what variables are needed.

# ── Qdrant ────────────────────────────────────────────────────────────────────
# URL of the Qdrant server.
# Inside Docker the service name "qdrant" is the hostname.
# When running locally (outside Docker) use localhost.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=rag_scifact

# ── Embedding model ───────────────────────────────────────────────────────────
# The Hugging Face model used to generate embeddings.
# This model is free and runs locally — no API key needed.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Chunking defaults ─────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100
CHUNKING_STRATEGY=recursive

# ── Input data ────────────────────────────────────────────────────────────────
INPUT_DIR=./data/raw
