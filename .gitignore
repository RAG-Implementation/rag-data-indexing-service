# rag-data-indexing-service
# Adapted from ~/.gitignore_global (python, jupyter, venv, vscode, windows, macos, linux)
# with project-specific rules for local documents, embeddings, and Qdrant data.

# --- Project-specific ---------------------------------------------------------

# Local input documents (keep folder, ignore uploaded content)
data/raw/*
!data/raw/.gitkeep

# Generated or intermediate artifacts
data/processed/
data/cache/
logs/
reports/
tmp/
temp/

# Local embedding / Hugging Face model cache
.cache/
.huggingface/
models/
*.pt
*.bin
*.onnx
*.safetensors

# Local Qdrant persistence (when not using Docker volumes only)
qdrant_storage/
.qdrant/

# Docker local overrides and runtime files
docker-compose.override.yml
.docker/

# Environment and secrets (keep example files tracked)
.env
.env.*
!.env.example
!.env.*.example
*.local.yaml
*.local.yml
secrets/

# --- Author additions (from global Section 1) ---------------------------------

tree.txt

# To prevent Zone.Identifier files
*Zone.Identifier

# Conda environments
*.conda
*.envs
.env/
.envs/

# --- Python -------------------------------------------------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Django stuff
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff
instance/
.webassets-cache

# Scrapy stuff
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IPython
profile_default/
ipython_config.py

# pipenv
#Pipfile.lock

# poetry
#poetry.lock
poetry.toml

# pdm
#pdm.lock
.pdm.toml

# PEP 582
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# ruff
.ruff_cache/

# LSP config files
pyrightconfig.json

